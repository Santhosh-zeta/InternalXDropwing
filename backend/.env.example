# InternalX backend configuration. Copy to backend/.env (git-ignored), or let `scripts/dev.sh` do it.
# Every variable the backend reads is listed here (a test fails if one is missing).
# A line starting with "#" shows the default and is optional; uncomment to change it.
# The same variables go in the root .env for Docker (see docs/production-checklist.md).
# Check your setup any time: Settings > System in the app (Super Admin / MD), or the boot log.

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public origin of the app: used in invite / password-reset email links and as the default CORS
# origin. Required in production (https). In development http://localhost:3000 is assumed.
FRONTEND_URL=http://localhost:5000
# Extra browser origins allowed by CORS, comma separated. Not needed when the API serves the web app.
# Only for `next dev` on :3000: CORS_ORIGINS=http://localhost:3000
# CORS_ORIGINS=
# Number of reverse proxies in front of the app (Caddy / nginx / Cloudflare Tunnel = 1). Leave unset
# when exposed directly. A wrong value distorts client IPs and rate limiting.
# TRUST_PROXY=1
# Session cookie "Secure" flag. Default: on in production, off otherwise. false only for plain-http LANs.
# COOKIE_SECURE=false
# Log verbosity: trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info

# ─── Database (PostgreSQL 16) ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internalx
DB_USER=internalx_app
DB_PASSWORD=change_me
# Apply pending SQL migrations at boot (default). Set false to run `npm run migrate` yourself.
# AUTO_MIGRATE=true

# ─── Auth ────────────────────────────────────────────────────
# Required. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses to boot without a real value (32+ chars, not a placeholder).
JWT_SECRET=change_me_use_a_long_random_string
# Session lifetime.
# JWT_EXPIRES_IN=8h
# Separate key for the sign-in-code hash. Default: derived from JWT_SECRET.
# OTP_PEPPER=
# In-memory cache of session lookups, milliseconds (0 = always hit the database).
# SESSION_CACHE_TTL_MS=

# ─── First Super Admin (only used while NO Super Admin exists) ──
# On boot, if the database has no L1 user, one is created from these. Password: 12+ chars,
# mixed character classes, no placeholders. REMOVE BOOTSTRAP_ADMIN_PASSWORD after the first sign-in.
# Alternatively leave both empty and run `npm run create-admin` (password from CREATE_ADMIN_PASSWORD
# or a hidden prompt). `scripts/dev.sh` does this for local development.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# CREATE_ADMIN_PASSWORD=

# ─── Sign-up and Google sign-in ──────────────────────────────
# false (default): invite-only. true: /register creates PENDING accounts an admin must approve.
ALLOW_SELF_REGISTRATION=false
# Email domains allowed for self-registration and Google sign-in, comma separated.
# Set this to your own domains; the built-in default is only an example list.
ALLOWED_EMAIL_DOMAINS=dropwinggroups.com,dropwing.in,fenixa.com,persynix.com,grovia.in
# Optional "Continue with Google" (accounts must already exist). https://console.cloud.google.com/apis/credentials
# The id is public: the web app reads it from the API at runtime, no frontend build setting needed.
GOOGLE_CLIENT_ID=

# ─── Email (SMTP) ────────────────────────────────────────────
# Delivers sign-in codes, invites, password resets and digests. In development, without SMTP, the
# sign-in code is printed in the server log ("OTP for <email>") and invite links are shown to the admin.
# In production nobody can complete the code step without SMTP.
SMTP_HOST=
SMTP_PORT=465
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ─── AI features: "Ask InternalX", digest summaries, notes to tasks (all optional) ───
# Without ANTHROPIC_API_KEY the assistant shows "not set up" (admins see how to enable it) and the
# digest uses its built-in summary. See docs/ai-features.md.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-sonnet-5-5
# ASSISTANT_EFFORT=medium                   # low | medium | high
# ASSISTANT_MAX_OUTPUT_TOKENS=4096
# ASSISTANT_MAX_TOOL_ITERATIONS=6           # tool round-trips allowed per question
# ASSISTANT_DAILY_MESSAGE_CAP=100           # per user per day (messages + notes-to-tasks runs)
# ASSISTANT_DAILY_TOKEN_CAP=300000          # per user per day, input + output tokens
# ASSISTANT_RATE_PER_MIN=10                 # per user burst limit on chat / notes-to-tasks
# ASSISTANT_HISTORY_ROWS=40                 # stored messages replayed to the model per turn
# ANTHROPIC_BASE_URL=                       # only for a proxy / gateway
# DIGEST_AI_SUMMARY=true                    # false: never send digest data to the model
# DIGEST_MODEL=                             # default: ASSISTANT_MODEL

# ─── Scheduler: Monday digest + daily alerts (in-process) ────
# Default: ON in production, OFF in development. true / false overrides. Safe with several instances
# (Postgres advisory lock + a run log in scheduler_runs). Without SMTP digests are in-app only.
# ENABLE_SCHEDULER=true
APP_TIMEZONE=Asia/Kolkata
# DIGEST_HOUR=8                             # Mondays, local time
# ALERTS_HOUR=9                             # every day, local time
# SCHEDULER_TICK_MS=300000
# ALERT_MAX_HOURS_PER_DAY=14                # timesheet anomaly threshold
# ALERT_OVERDUE_CLUSTER=3                   # overdue tasks in one project
# ALERT_IDLE_DAYS=14                        # active project with no activity

# ─── Local demo data only (never in production) ──────────────
# Password for the demo accounts created by `node scripts/seed-demo.js` (default: random, printed once).
# DEMO_PASSWORD=
