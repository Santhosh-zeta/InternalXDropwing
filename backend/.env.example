# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Origin allowed by CORS and used in password-reset / invite emails
FRONTEND_URL=http://localhost:3000

# Apply pending SQL migrations at boot (default). Set false to run `npm run migrate` yourself.
AUTO_MIGRATE=true

# ─── PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internalx
DB_USER=internalx_app
DB_PASSWORD=change_me

# ─── Auth ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_use_a_long_random_string
JWT_EXPIRES_IN=8h
# Production refuses to boot without a real JWT_SECRET (>= 32 chars, not a placeholder).

# ─── First-run admin (only used while NO Super Admin exists) ────
# On first boot, if the database has no L1 user, one is created from these.
# Password: min 12 chars, mixed character classes, no placeholders. Remove
# BOOTSTRAP_ADMIN_PASSWORD from the environment after the first successful boot.
# Alternatively leave both blank and run `npm run create-admin` in backend/.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Sign-up / Google sign-in allowlist ──────────────────────
# Comma-separated email domains allowed to self-register and to sign in with Google.
# Self-registration is OFF by default (invite-only). When true, /api/auth/register creates
# inactive, venture-less accounts that an admin must approve.
ALLOW_SELF_REGISTRATION=false
ALLOWED_EMAIL_DOMAINS=dropwinggroups.com,dropwing.in,fenixa.com,persynix.com,grovia.in

# ─── Google OAuth (optional — login/register "Continue with Google") ───
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── SMTP (optional — OTP, password reset, notifications) ────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ─── AI features: "Ask InternalX", digest summaries, notes to tasks (all optional) ───
# Set ANY ONE provider key. Without one the assistant reports "not configured" (admins see a setup
# hint, everyone else sees nothing) and the digest uses its deterministic summary. See docs/ai-features.md.
# If several keys are set the first of anthropic > openai > gemini is used, unless AI_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=                           # accepted instead of GEMINI_API_KEY
# AI_PROVIDER=                              # anthropic | openai | gemini (default: auto-detect from the key)
# AI_MODEL=                                 # default: claude-sonnet-5-5 / gpt-5 / gemini-2.5-flash; if the model is
#                                           # not in the account's model list the best available one is used (logged)
# OPENAI_BASE_URL=                          # OpenAI-compatible gateway (Azure, OpenRouter, Ollama...), e.g. https://openrouter.ai/api/v1
# GEMINI_BASE_URL=                          # only for a proxy / gateway
# ASSISTANT_MODEL=                          # legacy alias of AI_MODEL, Anthropic only
# ASSISTANT_EFFORT=medium                   # low | medium | high
# ASSISTANT_MAX_OUTPUT_TOKENS=4096
# ASSISTANT_MAX_TOOL_ITERATIONS=6           # tool round-trips allowed per question
# ASSISTANT_DAILY_MESSAGE_CAP=100           # per user per day (messages + notes-to-tasks runs)
# ASSISTANT_DAILY_TOKEN_CAP=300000          # per user per day, input + output tokens
# ASSISTANT_RATE_PER_MIN=10                 # per user burst limit on chat / notes-to-tasks
# ASSISTANT_HISTORY_ROWS=40                 # stored messages replayed to the model per turn
# ANTHROPIC_BASE_URL=                       # only for a proxy / gateway
# DIGEST_AI_SUMMARY=true                    # set false to never send digest data to the model
# DIGEST_MODEL=                             # defaults to AI_MODEL

# ─── Scheduler: Monday digest + daily alerts (in-process, off by default) ───
# Safe with several instances (Postgres advisory lock + a run log in scheduler_runs).
ENABLE_SCHEDULER=false
APP_TIMEZONE=Asia/Kolkata
# DIGEST_HOUR=8                             # Mondays, local time
# ALERTS_HOUR=9                             # every day, local time
# SCHEDULER_TICK_MS=300000
# ALERT_MAX_HOURS_PER_DAY=14                # timesheet anomaly threshold
# ALERT_OVERDUE_CLUSTER=3                   # overdue tasks in one project
# ALERT_IDLE_DAYS=14                        # active project with no activity
