# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Origin allowed by CORS and used in password-reset / invite emails
FRONTEND_URL=http://localhost:3000

# ─── PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internalx
DB_USER=internalx_app
DB_PASSWORD=change_me

# ─── Auth ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_use_a_long_random_string
JWT_EXPIRES_IN=8h

# ─── Google OAuth (optional — login/register "Continue with Google") ───
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── SMTP (optional — OTP, password reset, notifications) ────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
