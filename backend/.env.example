# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Origin allowed by CORS and used in password-reset / invite emails
FRONTEND_URL=http://localhost:3000

# ─── PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internalx
DB_USER=internalx_app
DB_PASSWORD=change_me

# ─── Auth ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_use_a_long_random_string
JWT_EXPIRES_IN=8h
# Production refuses to boot without a real JWT_SECRET (>= 32 chars, not a placeholder).

# ─── First-run admin (only used while NO Super Admin exists) ────
# On first boot, if the database has no L1 user, one is created from these.
# Password: min 12 chars, mixed character classes, no placeholders. Remove
# BOOTSTRAP_ADMIN_PASSWORD from the environment after the first successful boot.
# Alternatively leave both blank and run `npm run create-admin` in backend/.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Sign-up / Google sign-in allowlist ──────────────────────
# Comma-separated email domains allowed to self-register and to sign in with Google.
ALLOWED_EMAIL_DOMAINS=dropwinggroups.com,dropwing.in,fenixa.com,persynix.com,grovia.in

# ─── Google OAuth (optional — login/register "Continue with Google") ───
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── SMTP (optional — OTP, password reset, notifications) ────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
