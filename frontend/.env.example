# Frontend environment (optional). Copy to .env.local only for `next dev`.
#
# In production, and when the backend serves the web app (scripts/dev.sh, Docker),
# leave NEXT_PUBLIC_API_URL UNSET: every request is same-origin, so there is no CORS
# and no build argument to get wrong. Google sign-in needs no build setting either:
# the backend hands the public client id to the page at runtime.
#
# Only for `next dev` on :3000 with the API on :5000 (also add CORS_ORIGINS=http://localhost:3000
# to backend/.env):
# NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: ISO currency code used to display money (default USD). Baked in at build time.
# NEXT_PUBLIC_CURRENCY=USD
