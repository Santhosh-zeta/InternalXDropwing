# Frontend environment. Copy to .env.local for local development.
#
# Production: leave NEXT_PUBLIC_API_URL unset. The backend serves this app and the API
# from the same origin, so every request is same-origin (no CORS, cookies just work).
#
# `next dev` (port 3000) with the backend on port 5000: point the app at the backend.
# The backend must allow that origin (CORS_ORIGINS=http://localhost:3000 in backend/.env).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: public Google OAuth client id (must match the backend GOOGLE_CLIENT_ID).
# The Google button only shows when the backend also reports Google login as enabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: ISO currency code used to display money (default USD).
NEXT_PUBLIC_CURRENCY=USD
